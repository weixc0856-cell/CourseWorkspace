# ---------------------------------------------------------------------------
# 本地运行态（不入库）
# ---------------------------------------------------------------------------
runtime/
build/
deliver/
RemotionStudio/public/staging/
# Project media under public/ is content, not workflow: ignore the whole
# directory rather than relying on per-extension rules, which let PNGs through.
RemotionStudio/public/fengshui/
RemotionStudio/public/vibe/

# ---------------------------------------------------------------------------
# 教材知识库（版权内容，仅本地）
# ---------------------------------------------------------------------------
/knowledge/

# ---------------------------------------------------------------------------
# 真实课程内容（仅本地；仓库只保留 lessons/README.md）
# ---------------------------------------------------------------------------
/lessons/*
!/lessons/README.md

# ---------------------------------------------------------------------------
# 领域方案（课程开发内容，仅本机）
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 大文件与媒体（远程仓库不接收）
# ---------------------------------------------------------------------------
*.mp4
*.mov
*.webm
*.wav
*.mp3
*.flac
*.m4a
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt
*.blend1

# ---------------------------------------------------------------------------
# 本机配置（凭据与本机绝对路径）
config/*.yaml
!config/*.example.yaml
# 环境变量文件
.env
.env.*
!.env.example
# ---------------------------------------------------------------------------
config/tools.yaml
config/local-paths.yaml
config/content-qa.yaml
ModelingStudio/config/workflow.yaml

# ---------------------------------------------------------------------------
# 依赖与缓存
# ---------------------------------------------------------------------------
node_modules/
.venv/
__pycache__/
*.pyc
debug.log
# Local integration-test target (names a course; never committed)
CourseControl/tests/local-lesson.yaml
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ---------------------------------------------------------------------------
# 各工程运行态
# ---------------------------------------------------------------------------
ModelingStudio/workspace/
ManimSandbox/media/
MotionStudio/output/

# CodeVideoStudio generated outputs (specs and source stay tracked)
CodeVideoStudio/shots/*/out/
# Per-shot locks are environment-specific; the shot source is what gets tracked.
CodeVideoStudio/shots/*/package-lock.json
CodeVideoStudio/backends/hyperframes/*/out/
CodeVideoStudio/backends/hyperframes/hf-poc/.hyperframes/

ScientificFigures/output/

# Course scenes and tasks live in the content root; `course-control separation`
# reports any lesson-shaped directory that appears in this repository.


# BrandIntro: reference captures and render tests are media, not workflow
BrandIntro/art_direction/frames/
BrandIntro/art_tests/*/out/

# Vendored three.js is copied into shots at build time.
CodeVideoStudio/shots/*/three.module.js

# Brand intro/desktop: commit source; keep renders, previews and Blender backups local.
CodeVideoStudio/shots/brand-*/out/
CodeVideoStudio/shots/brand-intro/brand-rise/
CodeVideoStudio/shots/brand-intro/env-*.png
CodeVideoStudio/shots/brand-intro/character-*.png
CodeVideoStudio/shots/brand-*/*.blend1
CodeVideoStudio/shots/brand-intro/film.before-*.js

# 课程场景目录（junction 指向内容根；仓库不保存课程内容）
MotionStudio/src/scenes/*/
!MotionStudio/src/scenes/lesson-manual/
/build/
MotionStudio/src/scenes.generated.js

# Proprietary font: keep the local copy, never publish it.
assets/fonts/arial.ttf
# Machine-specific config backups.
config/*.bak-*
