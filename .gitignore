# ---------------------------------------------------------------------------
# 本地运行态（不入库）
# ---------------------------------------------------------------------------
runtime/
build/
RemotionStudio/public/staging/

# ---------------------------------------------------------------------------
# 教材知识库（版权内容，仅本地）
# ---------------------------------------------------------------------------
/knowledge/

# ---------------------------------------------------------------------------
# 真实课程内容（仅本地；仓库只保留 lessons/README.md）
# ---------------------------------------------------------------------------
/lessons/*
!/lessons/README.md

# ---------------------------------------------------------------------------
# 大文件与媒体（远程仓库不接收）
# ---------------------------------------------------------------------------
*.mp4
*.mov
*.webm
*.wav
*.mp3
*.flac
*.m4a
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt
*.blend1

# ---------------------------------------------------------------------------
# 本机配置（凭据与本机绝对路径）
config/*.yaml
!config/*.example.yaml
# 环境变量文件
.env
.env.*
!.env.example
# ---------------------------------------------------------------------------
config/tools.yaml
config/local-paths.yaml
config/content-qa.yaml
ModelingStudio/config/workflow.yaml

# ---------------------------------------------------------------------------
# 依赖与缓存
# ---------------------------------------------------------------------------
node_modules/
.venv/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ---------------------------------------------------------------------------
# 各工程运行态
# ---------------------------------------------------------------------------
ModelingStudio/workspace/
ManimSandbox/media/
MotionStudio/output/

# CodeVideoStudio generated outputs (specs and source stay tracked)
CodeVideoStudio/shots/*/out/
# Per-shot locks are environment-specific; the shot source is what gets tracked.
CodeVideoStudio/shots/*/package-lock.json
CodeVideoStudio/backends/hyperframes/*/out/
CodeVideoStudio/backends/hyperframes/hf-poc/.hyperframes/

# Course-specific pilot sources (real course content stays local)
/BlenderStudio/scenes/01-transformer-demo/
/BlenderStudio/tasks/01-transformer-demo/
/ManimSandbox/01-transformer-demo/
/ManimSandbox/02-car-aerodynamics/
ScientificFigures/output/

# Local archive: finished project reports stay out of the remote
/docs/archive/*
!/docs/archive/README.md
