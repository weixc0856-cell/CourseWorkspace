        "sub": "Short pipeline · not a published film",
        "size": "normal"
      },
      "purpose": "orient"
    },
    {
      "id": "paper",
      "kind": "paper_highlight",
      "duration_s": 6,
      "props": {
        "image": "staging/ip-samples/fig-1.3.png",
        "box": {
          "x": 0.34,
          "y": 0.55,
          "w": 0.36,
          "h": 0.3
        },
        "label": "Separation",
        "caption": "Perpendicular and oblique separation, read from the original figure.",
        "source": "Hucho, 5th ed., Fig. 1.3 — component proof only"
      },
      "purpose": "demonstrate"
    },
    {
      "id": "split",
      "kind": "split_compare",
      "duration_s": 5,
      "props": {
        "left": {
          "label": "Feels like",
          "title": "99%",
          "accent": "muted",
          "points": [
            "A precise test"
          ]
        },
        "right": {
          "label": "Means",
          "title": "50%",
          "accent": "accent",
          "points": [
            "A base-rate problem"
          ]
        },
        "verdict": "Same evidence, different reading"
      },
      "purpose": "compare"
    },
    {
      "id": "bars",
      "kind": "metric_bar",
      "duration_s": 5,
      "props": {
        "title": "50 positive results",
        "data": [
          {
            "label": "True",
            "value": 25,
            "color": "accent"
          },
          {
            "label": "False",
            "value": 25,
            "color": "red"
          }
        ],
        "max": 50,
        "source": "Illustrative cohort"
      },
      "purpose": "demonstrate"
    },
    {
      "id": "flow",
      "kind": "simple_flow",
      "duration_s": 6,
      "props": {
        "title": "Rare event, many alarms",
        "steps": [
          {
            "label": "Rare event",
            "detail": "1 in 10,000",
            "accent": "blue"
          },
          {
            "label": "99% test",
            "detail": "flags it",
            "accent": "teal"
          },
          {
            "label": "Most alarms false",
            "detail": "about 100 per true one",
            "accent": "accent"
          }
        ],
        "footer": "The components carry the argument, not decoration."
      },
      "purpose": "explain"
    }
  ],
  "captions": []
