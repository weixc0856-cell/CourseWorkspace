{
  "schema_version": 1,
  "note": "Only components a timeline may name belong here. Animation wrappers (DesignMotion, MotionImage) and the raw Formula primitive are internal helpers and stay unregistered on purpose: they do not carry a full screen, so a timeline that references them is a modelling error, not a missing entry.",
  "components": {
    "CarFlow": {
      "path": "RemotionStudio/src/components/CarFlow.tsx",
      "props": [
        "t",
        "car"
      ],
      "max_seconds": 30,
      "golden": "build/_shared/golden/chapter-750.png",
      "qc": [
        "flow direction matches the car heading",
        "body proportions readable",
        "no clipping through the ground"
      ]
    },
    "MechanismDiagram": {
      "path": "RemotionStudio/src/components/MechanismDiagram.tsx",
      "props": [
        "eyebrow",
        "title",
        "leftLabel",
        "leftNote",
        "rightLabel",
        "rightNote"
      ],
      "max_seconds": 40,
      "golden": "build/_shared/golden/chapter-1800.png",
      "qc": [
        "the mechanism is shown, not only the result",
        "labels match the formulas",
        "no text collision"
      ],
      "provisional": true
    },
    "ChartOverlay": {
