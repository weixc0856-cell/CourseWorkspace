{
  "$defs": {
    "Finding": {
      "description": "One candidate claim from the online model. Never a final decision.",
      "properties": {
        "slide": {
          "minimum": 1,
          "title": "Slide",
          "type": "integer"
        },
        "claim": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "verdict": {
          "default": "needs_human_review",
          "enum": [
            "supported",
            "unsupported",
            "disputed",
            "needs_human_review",
            "not_checked"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "slide",
        "claim"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ReviewTask": {
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "slide": {
          "title": "Slide",
          "type": "integer"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "blocked",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "estimated_input_tokens": {
          "default": 0,
          "title": "Estimated Input Tokens",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "task_id",
        "slide",
        "status"
      ],
      "title": "ReviewTask",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "lesson": {
      "title": "Lesson",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "base_url": {
      "title": "Base Url",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/ReviewTask"
      },
      "title": "Tasks",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    }
  },
  "required": [
    "lesson",
    "generated_at",
    "model",
    "base_url",
    "status"
  ],
  "title": "ReviewReport",
  "type": "object"
}
