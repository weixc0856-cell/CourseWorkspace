{
  "$defs": {
    "LegendAnnotation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "legend",
          "title": "Kind",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "position": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "colormap": {
          "title": "Colormap",
          "type": "string"
        },
        "min_value": {
          "title": "Min Value",
          "type": "number"
        },
        "max_value": {
          "title": "Max Value",
          "type": "number"
        },
        "units": {
          "title": "Units",
          "type": "string"
        },
        "stops": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "maxItems": 3,
                "minItems": 3,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              }
            ],
            "type": "array"
          },
          "title": "Stops",
          "type": "array"
        },
        "bar_height": {
          "maximum": 800,
          "minimum": 40,
          "title": "Bar Height",
          "type": "number"
        },
        "bar_width": {
          "maximum": 120,
          "minimum": 8,
          "title": "Bar Width",
          "type": "number"
        },
        "label_size": {
          "maximum": 96,
          "minimum": 8,
          "title": "Label Size",
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "start_s",
        "duration_s",
        "position",
        "colormap",
        "min_value",
        "max_value",
        "units",
        "stops",
        "bar_height",
        "bar_width",
        "label_size"
      ],
      "title": "LegendAnnotation",
      "type": "object"
    },
    "Shot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "slide",
            "animation",
            "recording"
          ],
          "title": "Kind",
          "type": "string"
        },
        "slide": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slide"
        },
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "timeline_role": {
          "enum": [
            "base",
            "overlay"
          ],
          "title": "Timeline Role",
          "type": "string"
        },
        "presentation": {
          "anyOf": [
            {
              "enum": [
                "cutaway",
                "picture_in_picture",
                "transparent_overlay"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Presentation"
        },
        "transition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "theme": {
          "anyOf": [
            {
              "enum": [
                "editorial_science",
                "deep_space",
                "engineering_studio"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Theme"
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "start_s",
        "duration_s",
        "timeline_role"
      ],
      "title": "Shot",
      "type": "object"
    },
    "TextAnnotation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "text",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "position": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "size": {
          "maximum": 200,
          "minimum": 8,
          "title": "Size",
          "type": "number"
        },
        "align": {
          "default": "center",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "title": "Align",
          "type": "string"
        },
        "color": {
          "default": "text",
          "enum": [
            "text",
            "muted",
            "orange",
            "white"
          ],
          "title": "Color",
          "type": "string"
        },
        "background": {
          "default": false,
          "title": "Background",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "start_s",
        "duration_s",
        "position",
        "size"
      ],
      "title": "TextAnnotation",
      "type": "object"
    },
    "Timeline": {
      "additionalProperties": false,
      "properties": {
        "fps": {
          "exclusiveMinimum": 0,
          "title": "Fps",
          "type": "integer"
        },
        "resolution": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Resolution",
          "type": "array"
        },
        "total_duration_s": {
          "exclusiveMinimum": 0,
          "title": "Total Duration S",
          "type": "number"
        }
      },
      "required": [
        "fps",
        "resolution",
        "total_duration_s"
      ],
      "title": "Timeline",
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "description": "Visual transition into/out of a shot; never changes the shot's duration.",
      "properties": {
        "in": {
          "default": "hard_cut",
          "enum": [
            "hard_cut",
            "fade",
            "dissolve",
            "match_cut",
            "wipe"
          ],
          "title": "In",
          "type": "string"
        },
        "out": {
          "default": "hard_cut",
          "enum": [
            "hard_cut",
            "fade",
            "dissolve",
            "match_cut",
            "wipe"
          ],
          "title": "Out",
          "type": "string"
        }
      },
      "title": "Transition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "lesson": {
      "title": "Lesson",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "timeline": {
      "$ref": "#/$defs/Timeline"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/Shot"
      },
      "title": "Shots",
      "type": "array"
    },
    "annotations": {
      "items": {
        "discriminator": {
          "mapping": {
            "legend": "#/$defs/LegendAnnotation",
            "text": "#/$defs/TextAnnotation"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TextAnnotation"
          },
          {
            "$ref": "#/$defs/LegendAnnotation"
          }
        ]
      },
      "title": "Annotations",
      "type": "array"
    },
    "narration": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Narration"
    },
    "subtitles": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subtitles"
    }
  },
  "required": [
    "lesson",
    "generated_at",
    "timeline",
    "shots"
  ],
  "title": "ShotsFile",
  "type": "object"
}
