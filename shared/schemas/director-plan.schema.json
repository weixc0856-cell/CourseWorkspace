{
  "$defs": {
    "ApprovalArtifact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "missing",
            "mismatch",
            "unapproved"
          ],
          "title": "Status",
          "type": "string"
        },
        "sha256": {
          "default": "",
          "title": "Sha256",
          "type": "string"
        },
        "approved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        }
      },
      "required": [
        "kind",
        "path",
        "status"
      ],
      "title": "ApprovalArtifact",
      "type": "object"
    },
    "ApprovalState": {
      "additionalProperties": false,
      "properties": {
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ApprovalArtifact"
          },
          "title": "Artifacts",
          "type": "array"
        }
      },
      "required": [
        "approved"
      ],
      "title": "ApprovalState",
      "type": "object"
    },
    "ChapterPlan": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "learning_objective": {
          "minLength": 1,
          "title": "Learning Objective",
          "type": "string"
        },
        "target_seconds": {
          "exclusiveMinimum": 0,
          "title": "Target Seconds",
          "type": "number"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "shot_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Shot Ids",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "learning_objective",
        "target_seconds",
        "start_s",
        "end_s",
        "shot_ids"
      ],
      "title": "ChapterPlan",
      "type": "object"
    },
    "DirectorCheck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "level": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Level",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "shot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shot Id"
        },
        "chapter_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chapter Id"
        }
      },
      "required": [
        "id",
        "rule",
        "level",
        "message"
      ],
      "title": "DirectorCheck",
      "type": "object"
    },
    "DirectorSummary": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "draft",
            "ready",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "errors": {
          "default": 0,
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "warnings": {
          "default": 0,
          "minimum": 0,
          "title": "Warnings",
          "type": "integer"
        },
        "infos": {
          "default": 0,
          "minimum": 0,
          "title": "Infos",
          "type": "integer"
        },
        "shots": {
          "minimum": 0,
          "title": "Shots",
          "type": "integer"
        },
        "ready_shots": {
          "minimum": 0,
          "title": "Ready Shots",
          "type": "integer"
        },
        "planned_shots": {
          "minimum": 0,
          "title": "Planned Shots",
          "type": "integer"
        },
        "chapters": {
          "minimum": 0,
          "title": "Chapters",
          "type": "integer"
        },
        "narration_segments": {
          "minimum": 0,
          "title": "Narration Segments",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "shots",
        "ready_shots",
        "planned_shots",
        "chapters",
        "narration_segments"
      ],
      "title": "DirectorSummary",
      "type": "object"
    },
    "DurationPlan": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "standard",
            "short",
            "news"
          ],
          "title": "Profile",
          "type": "string"
        },
        "target_seconds": {
          "exclusiveMinimum": 0,
          "title": "Target Seconds",
          "type": "number"
        },
        "min_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Seconds"
        },
        "max_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Seconds"
        },
        "planned_seconds": {
          "exclusiveMinimum": 0,
          "title": "Planned Seconds",
          "type": "number"
        },
        "tolerance_seconds": {
          "default": 2.0,
          "minimum": 0,
          "title": "Tolerance Seconds",
          "type": "number"
        }
      },
      "required": [
        "profile",
        "target_seconds",
        "planned_seconds"
      ],
      "title": "DurationPlan",
      "type": "object"
    },
    "NarrationSegmentPlan": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
          "title": "Id",
          "type": "string"
        },
        "shot_id": {
          "pattern": "^shot_[0-9]{3}$",
          "title": "Shot Id",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "text": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "style": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style"
        },
        "pause_after_ms": {
          "default": 400,
          "maximum": 5000,
          "minimum": 0,
          "title": "Pause After Ms",
          "type": "integer"
        },
        "estimated_seconds": {
          "exclusiveMinimum": 0,
          "title": "Estimated Seconds",
          "type": "number"
        },
        "emphasis": {
          "items": {
            "type": "string"
          },
          "title": "Emphasis",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "shot_id",
        "page",
        "text",
        "estimated_seconds"
      ],
      "title": "NarrationSegmentPlan",
      "type": "object"
    },
    "ShotPlan": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^shot_[0-9]{3}$",
          "title": "Id",
          "type": "string"
        },
        "chapter_id": {
          "title": "Chapter Id",
          "type": "string"
        },
        "slide": {
          "minimum": 1,
          "title": "Slide",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "introduce",
            "explain",
            "demonstrate",
            "contrast",
            "summarize",
            "recap"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "engine": {
          "enum": [
            "motion_canvas",
            "manim",
            "blender",
            "code_video",
            "remotion"
          ],
          "title": "Engine",
          "type": "string"
        },
        "engine_profile": {
          "minLength": 1,
          "title": "Engine Profile",
          "type": "string"
        },
        "scene": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene"
        },
        "blend_task": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blend Task"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "asset_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Seconds"
        },
        "readiness": {
          "enum": [
            "ready",
            "planned"
          ],
          "title": "Readiness",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "cue_seconds": {
          "minimum": 0,
          "title": "Cue Seconds",
          "type": "number"
        },
        "target_seconds": {
          "exclusiveMinimum": 0,
          "title": "Target Seconds",
          "type": "number"
        },
        "transition": {
          "enum": [
            "cut",
            "continuous"
          ],
          "title": "Transition",
          "type": "string"
        },
        "layout_template": {
          "pattern": "^[a-z][a-z0-9_]{2,40}$",
          "title": "Layout Template",
          "type": "string"
        },
        "layout_regions": {
          "additionalProperties": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Layout Regions",
          "type": "object"
        },
        "shot_size": {
          "default": "medium",
          "enum": [
            "wide",
            "medium",
            "closeup"
          ],
          "title": "Shot Size",
          "type": "string"
        },
        "learning_intent": {
          "minLength": 1,
          "title": "Learning Intent",
          "type": "string"
        },
        "visual_metaphor": {
          "minLength": 1,
          "title": "Visual Metaphor",
          "type": "string"
        },
        "composition": {
          "minLength": 1,
          "title": "Composition",
          "type": "string"
        },
        "camera": {
          "minLength": 1,
          "title": "Camera",
          "type": "string"
        },
        "motion": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Motion",
          "type": "array"
        },
        "on_screen_text": {
          "items": {
            "type": "string"
          },
          "title": "On Screen Text",
          "type": "array"
        },
        "narration_ids": {
          "items": {
            "type": "string"
          },
          "title": "Narration Ids",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "direction_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction File"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "id",
        "chapter_id",
        "slide",
        "title",
        "purpose",
        "engine",
        "engine_profile",
        "readiness",
        "start_s",
        "end_s",
        "cue_seconds",
        "target_seconds",
        "transition",
        "layout_template",
        "learning_intent",
        "visual_metaphor",
        "composition",
        "camera",
        "motion"
      ],
      "title": "ShotPlan",
      "type": "object"
    },
    "Typography": {
      "additionalProperties": false,
      "properties": {
        "heading_px": {
          "maximum": 400,
          "minimum": 8,
          "title": "Heading Px",
          "type": "integer"
        },
        "body_px": {
          "maximum": 400,
          "minimum": 8,
          "title": "Body Px",
          "type": "integer"
        },
        "label_px": {
          "maximum": 400,
          "minimum": 8,
          "title": "Label Px",
          "type": "integer"
        },
        "heading_font": {
          "minLength": 1,
          "title": "Heading Font",
          "type": "string"
        },
        "body_font": {
          "minLength": 1,
          "title": "Body Font",
          "type": "string"
        }
      },
      "required": [
        "heading_px",
        "body_px",
        "label_px",
        "heading_font",
        "body_font"
      ],
      "title": "Typography",
      "type": "object"
    },
    "VisualStyle": {
      "additionalProperties": false,
      "properties": {
        "background": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Background",
          "type": "string"
        },
        "ink": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Ink",
          "type": "string"
        },
        "muted": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Muted",
          "type": "string"
        },
        "accent": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Accent",
          "type": "string"
        },
        "warm": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Warm",
          "type": "string"
        },
        "green": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Green",
          "type": "string"
        },
        "typography": {
          "$ref": "#/$defs/Typography"
        },
        "color_semantics": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Color Semantics",
          "type": "object"
        },
        "consistency_required": {
          "default": true,
          "title": "Consistency Required",
          "type": "boolean"
        }
      },
      "required": [
        "background",
        "ink",
        "muted",
        "accent",
        "warm",
        "green",
        "typography",
        "color_semantics"
      ],
      "title": "VisualStyle",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "lesson_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "title": "Lesson Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "approval": {
      "$ref": "#/$defs/ApprovalState"
    },
    "duration": {
      "$ref": "#/$defs/DurationPlan"
    },
    "style": {
      "$ref": "#/$defs/VisualStyle"
    },
    "chapters": {
      "items": {
        "$ref": "#/$defs/ChapterPlan"
      },
      "minItems": 1,
      "title": "Chapters",
      "type": "array"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/ShotPlan"
      },
      "minItems": 1,
      "title": "Shots",
      "type": "array"
    },
    "narration": {
      "items": {
        "$ref": "#/$defs/NarrationSegmentPlan"
      },
      "title": "Narration",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/DirectorCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/DirectorSummary"
    },
    "generator": {
      "additionalProperties": true,
      "title": "Generator",
      "type": "object"
    }
  },
  "required": [
    "lesson_id",
    "title",
    "status",
    "approval",
    "duration",
    "style",
    "chapters",
    "shots",
    "summary"
  ],
  "title": "DirectorPlan",
  "type": "object"
}
