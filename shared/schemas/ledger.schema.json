{
  "$defs": {
    "LedgerRecord": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "book_figure",
            "paper_figure",
            "photo",
            "video",
            "screen",
            "render",
            "schematic",
            "data"
          ],
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "enum": [
            "render_only",
            "evidence",
            "context",
            "schematic",
            "data"
          ],
          "title": "Role",
          "type": "string"
        },
        "path": {
          "default": null,
          "title": "Path",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "default": null,
          "title": "Source Url",
          "type": "string"
        },
        "publisher": {
          "default": null,
          "title": "Publisher",
          "type": "string"
        },
        "captured_at": {
          "default": null,
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "attribution": {
          "default": null,
          "title": "Attribution",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "used_in": {
          "items": {
            "type": "string"
          },
          "title": "Used In",
          "type": "array"
        },
        "notes": {
          "default": null,
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "kind",
        "role",
        "source",
        "license"
      ],
      "title": "LedgerRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "product": {
      "minLength": 1,
      "title": "Product",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/LedgerRecord"
      },
      "title": "Records",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "product",
    "records"
  ],
  "title": "Visual asset ledger",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courseworkspace.local/schemas/ledger.schema.json"
}
