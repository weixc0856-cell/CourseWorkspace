{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "description": "A file reference with content identity and provenance.",
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "video",
            "audio",
            "image",
            "subtitle",
            "font",
            "data",
            "log",
            "json"
          ],
          "title": "Kind",
          "type": "string"
        },
        "origin": {
          "enum": [
            "author",
            "rendered",
            "captured",
            "generated",
            "external"
          ],
          "title": "Origin",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "kind",
        "origin"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "LessonAcceptance": {
      "additionalProperties": false,
      "properties": {
        "min_duration_frames": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Duration Frames"
        },
        "max_duration_frames": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Duration Frames"
        },
        "required_checks": {
          "items": {
            "type": "string"
          },
          "title": "Required Checks",
          "type": "array"
        }
      },
      "title": "LessonAcceptance",
      "type": "object"
    },
    "LessonAudio": {
      "additionalProperties": false,
      "properties": {
        "sample_rate": {
          "default": 48000,
          "exclusiveMinimum": 0,
          "maximum": 384000,
          "title": "Sample Rate",
          "type": "integer"
        },
        "channels": {
          "default": 1,
          "maximum": 8,
          "minimum": 1,
          "title": "Channels",
          "type": "integer"
        }
      },
      "title": "LessonAudio",
      "type": "object"
    },
    "LessonNarration": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "LessonNarration",
      "type": "object"
    },
    "LessonOutput": {
      "additionalProperties": false,
      "properties": {
        "fps": {
          "$ref": "#/$defs/RationalFPS"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 16384,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 16384,
          "title": "Height",
          "type": "integer"
        },
        "audio": {
          "$ref": "#/$defs/LessonAudio",
          "default": {
            "sample_rate": 48000,
            "channels": 1
          }
        }
      },
      "required": [
        "fps",
        "width",
        "height"
      ],
      "title": "LessonOutput",
      "type": "object"
    },
    "LessonSource": {
      "additionalProperties": false,
      "properties": {
        "lesson_yaml": {
          "$ref": "#/$defs/AssetRef"
        },
        "storyboard": {
          "$ref": "#/$defs/AssetRef"
        }
      },
      "required": [
        "lesson_yaml",
        "storyboard"
      ],
      "title": "LessonSource",
      "type": "object"
    },
    "LessonSubtitles": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "format": {
          "const": "srt",
          "default": "srt",
          "title": "Format",
          "type": "string"
        },
        "spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "LessonSubtitles",
      "type": "object"
    },
    "RationalFPS": {
      "additionalProperties": false,
      "description": "Exact frame rate as a rational number, e.g. 30000/1001.",
      "properties": {
        "fps_num": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Fps Num",
          "type": "integer"
        },
        "fps_den": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Fps Den",
          "type": "integer"
        }
      },
      "required": [
        "fps_num",
        "fps_den"
      ],
      "title": "RationalFPS",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "kind": {
      "const": "lesson_spec",
      "default": "lesson_spec",
      "title": "Kind",
      "type": "string"
    },
    "lesson_id": {
      "title": "Lesson Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "in_progress",
        "done",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/LessonSource"
    },
    "output": {
      "$ref": "#/$defs/LessonOutput"
    },
    "tracks": {
      "items": {
        "enum": [
          "slide",
          "motion_canvas",
          "manim",
          "blender",
          "session",
          "simulation",
          "graphics"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Tracks",
      "type": "array"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetRef"
      },
      "title": "Assets",
      "type": "array"
    },
    "narration": {
      "$ref": "#/$defs/LessonNarration",
      "default": {
        "enabled": false,
        "spec": null
      }
    },
    "subtitles": {
      "$ref": "#/$defs/LessonSubtitles",
      "default": {
        "enabled": false,
        "format": "srt",
        "spec": null
      }
    },
    "acceptance": {
      "$ref": "#/$defs/LessonAcceptance",
      "default": {
        "min_duration_frames": null,
        "max_duration_frames": null,
        "required_checks": []
      }
    },
    "metadata": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metadata"
    }
  },
  "required": [
    "lesson_id",
    "title",
    "status",
    "source",
    "output",
    "tracks"
  ],
  "title": "LessonSpec",
  "type": "object"
}
