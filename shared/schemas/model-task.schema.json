{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelTaskRecord",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "assigned_model",
    "status",
    "input_artifacts",
    "output_artifacts",
    "context_budget",
    "timeout_s",
    "retry_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "assigned_model": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "local",
        "remote",
        "claude_code"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "blocked",
        "needs_review",
        "skipped"
      ]
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_budget": {
      "type": "object"
    },
    "timeout_s": {
      "type": "integer",
      "minimum": 1
    },
    "retry_policy": {
      "type": "object"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
