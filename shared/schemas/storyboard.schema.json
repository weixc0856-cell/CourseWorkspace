{
  "$defs": {
    "ContinuityObject": {
      "additionalProperties": false,
      "description": "A thing that must look the same every time it appears.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,47}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "ContinuityObject",
      "type": "object"
    },
    "LegendAnnotationSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "slide": {
          "minimum": 1,
          "title": "Slide",
          "type": "integer"
        },
        "cue_seconds": {
          "minimum": 0,
          "title": "Cue Seconds",
          "type": "number"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "position": {
          "default": [
            0.5,
            0.1
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "kind": {
          "const": "legend",
          "title": "Kind",
          "type": "string"
        },
        "colormap": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Colormap",
          "type": "string"
        },
        "min_value": {
          "maximum": 1000000000000.0,
          "minimum": -1000000000000.0,
          "title": "Min Value",
          "type": "number"
        },
        "max_value": {
          "maximum": 1000000000000.0,
          "minimum": -1000000000000.0,
          "title": "Max Value",
          "type": "number"
        },
        "units": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Units",
          "type": "string"
        },
        "bar_height": {
          "default": 240.0,
          "maximum": 800,
          "minimum": 40,
          "title": "Bar Height",
          "type": "number"
        },
        "bar_width": {
          "default": 28.0,
          "maximum": 120,
          "minimum": 8,
          "title": "Bar Width",
          "type": "number"
        },
        "label_size": {
          "default": 24.0,
          "maximum": 96,
          "minimum": 8,
          "title": "Label Size",
          "type": "number"
        }
      },
      "required": [
        "id",
        "slide",
        "cue_seconds",
        "duration_s",
        "kind",
        "colormap",
        "min_value",
        "max_value",
        "units"
      ],
      "title": "LegendAnnotationSpec",
      "type": "object"
    },
    "ShotSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "slide": {
          "minimum": 1,
          "title": "Slide",
          "type": "integer"
        },
        "engine": {
          "enum": [
            "motion_canvas",
            "manim",
            "blender",
            "code_video"
          ],
          "title": "Engine",
          "type": "string"
        },
        "scene": {
          "title": "Scene",
          "type": "string"
        },
        "cue_seconds": {
          "minimum": 0,
          "title": "Cue Seconds",
          "type": "number"
        },
        "expected_duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Duration S"
        },
        "blend_task": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blend Task"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "engine_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine Profile"
        },
        "inputs": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs"
        },
        "validation": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation"
        },
        "formula_ids": {
          "items": {
            "type": "string"
          },
          "title": "Formula Ids",
          "type": "array"
        },
        "theme": {
          "anyOf": [
            {
              "enum": [
                "editorial_science",
                "deep_space",
                "engineering_studio"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Theme"
        },
        "purpose": {
          "anyOf": [
            {
              "enum": [
                "explain",
                "demonstrate",
                "simulate",
                "compare",
                "narrate",
                "emote",
                "orient",
                "summarize"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "visual_action": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visual Action"
        },
        "composition": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Composition"
        },
        "continuity_refs": {
          "items": {
            "type": "string"
          },
          "title": "Continuity Refs",
          "type": "array"
        },
        "asset_refs": {
          "items": {
            "type": "string"
          },
          "title": "Asset Refs",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "transition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "director_notes": {
          "anyOf": [
            {
              "maxLength": 1200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Director Notes"
        }
      },
      "required": [
        "id",
        "slide",
        "engine",
        "scene",
        "cue_seconds"
      ],
      "title": "ShotSpec",
      "type": "object"
    },
    "TextAnnotationSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "slide": {
          "minimum": 1,
          "title": "Slide",
          "type": "integer"
        },
        "cue_seconds": {
          "minimum": 0,
          "title": "Cue Seconds",
          "type": "number"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "position": {
          "default": [
            0.5,
            0.1
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "kind": {
          "const": "text",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "size": {
          "default": 36.0,
          "maximum": 200,
          "minimum": 8,
          "title": "Size",
          "type": "number"
        },
        "align": {
          "default": "center",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "title": "Align",
          "type": "string"
        },
        "color": {
          "default": "text",
          "enum": [
            "text",
            "muted",
            "orange",
            "white"
          ],
          "title": "Color",
          "type": "string"
        },
        "background": {
          "default": false,
          "title": "Background",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "slide",
        "cue_seconds",
        "duration_s",
        "kind",
        "text"
      ],
      "title": "TextAnnotationSpec",
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "description": "Visual transition into/out of a shot; never changes the shot's duration.",
      "properties": {
        "in": {
          "default": "hard_cut",
          "enum": [
            "hard_cut",
            "fade",
            "dissolve",
            "match_cut",
            "wipe"
          ],
          "title": "In",
          "type": "string"
        },
        "out": {
          "default": "hard_cut",
          "enum": [
            "hard_cut",
            "fade",
            "dissolve",
            "match_cut",
            "wipe"
          ],
          "title": "Out",
          "type": "string"
        }
      },
      "title": "Transition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "enum": [
        1,
        2
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "lesson": {
      "title": "Lesson",
      "type": "string"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/ShotSpec"
      },
      "minItems": 1,
      "title": "Shots",
      "type": "array"
    },
    "annotations": {
      "items": {
        "discriminator": {
          "mapping": {
            "legend": "#/$defs/LegendAnnotationSpec",
            "text": "#/$defs/TextAnnotationSpec"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TextAnnotationSpec"
          },
          {
            "$ref": "#/$defs/LegendAnnotationSpec"
          }
        ]
      },
      "title": "Annotations",
      "type": "array"
    },
    "continuity": {
      "items": {
        "$ref": "#/$defs/ContinuityObject"
      },
      "title": "Continuity",
      "type": "array"
    }
  },
  "required": [
    "lesson",
    "shots"
  ],
  "title": "Storyboard",
  "type": "object"
}
