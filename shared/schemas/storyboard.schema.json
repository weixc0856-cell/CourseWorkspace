{
  "$defs": {
    "ShotSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "slide": {
          "minimum": 1,
          "title": "Slide",
          "type": "integer"
        },
        "engine": {
          "enum": [
            "motion_canvas",
            "manim",
            "blender"
          ],
          "title": "Engine",
          "type": "string"
        },
        "scene": {
          "title": "Scene",
          "type": "string"
        },
        "cue_seconds": {
          "minimum": 0,
          "title": "Cue Seconds",
          "type": "number"
        },
        "expected_duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Duration S"
        },
        "blend_task": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blend Task"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "id",
        "slide",
        "engine",
        "scene",
        "cue_seconds"
      ],
      "title": "ShotSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "lesson": {
      "title": "Lesson",
      "type": "string"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/ShotSpec"
      },
      "minItems": 1,
      "title": "Shots",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "lesson",
    "shots"
  ],
  "title": "Storyboard",
  "type": "object"
}
