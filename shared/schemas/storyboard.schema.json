{
  "$defs": {
    "LegendAnnotationSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "slide": {
          "minimum": 1,
          "title": "Slide",
          "type": "integer"
        },
        "cue_seconds": {
          "minimum": 0,
          "title": "Cue Seconds",
          "type": "number"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "position": {
          "default": [
            0.5,
            0.1
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "kind": {
          "const": "legend",
          "title": "Kind",
          "type": "string"
        },
        "colormap": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Colormap",
          "type": "string"
        },
        "min_value": {
          "maximum": 1000000000000.0,
          "minimum": -1000000000000.0,
          "title": "Min Value",
          "type": "number"
        },
        "max_value": {
          "maximum": 1000000000000.0,
          "minimum": -1000000000000.0,
          "title": "Max Value",
          "type": "number"
        },
        "units": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Units",
          "type": "string"
        },
        "bar_height": {
          "default": 240.0,
          "maximum": 800,
          "minimum": 40,
          "title": "Bar Height",
          "type": "number"
        },
        "bar_width": {
          "default": 28.0,
          "maximum": 120,
          "minimum": 8,
          "title": "Bar Width",
          "type": "number"
        },
        "label_size": {
          "default": 24.0,
          "maximum": 96,
          "minimum": 8,
          "title": "Label Size",
          "type": "number"
        }
      },
      "required": [
        "id",
        "slide",
        "cue_seconds",
        "duration_s",
        "kind",
        "colormap",
        "min_value",
        "max_value",
        "units"
      ],
      "title": "LegendAnnotationSpec",
      "type": "object"
    },
    "ShotSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "slide": {
          "minimum": 1,
          "title": "Slide",
          "type": "integer"
        },
        "engine": {
          "enum": [
            "motion_canvas",
            "manim",
            "blender"
          ],
          "title": "Engine",
          "type": "string"
        },
        "scene": {
          "title": "Scene",
          "type": "string"
        },
        "cue_seconds": {
          "minimum": 0,
          "title": "Cue Seconds",
          "type": "number"
        },
        "expected_duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Duration S"
        },
        "blend_task": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blend Task"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "id",
        "slide",
        "engine",
        "scene",
        "cue_seconds"
      ],
      "title": "ShotSpec",
      "type": "object"
    },
    "TextAnnotationSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "slide": {
          "minimum": 1,
          "title": "Slide",
          "type": "integer"
        },
        "cue_seconds": {
          "minimum": 0,
          "title": "Cue Seconds",
          "type": "number"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "position": {
          "default": [
            0.5,
            0.1
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "kind": {
          "const": "text",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "size": {
          "default": 36.0,
          "maximum": 200,
          "minimum": 8,
          "title": "Size",
          "type": "number"
        },
        "align": {
          "default": "center",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "title": "Align",
          "type": "string"
        },
        "color": {
          "default": "text",
          "enum": [
            "text",
            "muted",
            "orange",
            "white"
          ],
          "title": "Color",
          "type": "string"
        },
        "background": {
          "default": false,
          "title": "Background",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "slide",
        "cue_seconds",
        "duration_s",
        "kind",
        "text"
      ],
      "title": "TextAnnotationSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "lesson": {
      "title": "Lesson",
      "type": "string"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/ShotSpec"
      },
      "minItems": 1,
      "title": "Shots",
      "type": "array"
    },
    "annotations": {
      "items": {
        "discriminator": {
          "mapping": {
            "legend": "#/$defs/LegendAnnotationSpec",
            "text": "#/$defs/TextAnnotationSpec"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TextAnnotationSpec"
          },
          {
            "$ref": "#/$defs/LegendAnnotationSpec"
          }
        ]
      },
      "title": "Annotations",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "lesson",
    "shots"
  ],
  "title": "Storyboard",
  "type": "object"
}
