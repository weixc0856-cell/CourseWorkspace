{
  "$defs": {
    "ShortCaption": {
      "additionalProperties": false,
      "properties": {
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zh"
        }
      },
      "required": [
        "start_s",
        "end_s",
        "en"
      ],
      "title": "ShortCaption",
      "type": "object"
    },
    "ShortScene": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "statement",
            "split_compare",
            "paper_highlight",
            "metric_bar",
            "simple_flow"
          ],
          "title": "Kind",
          "type": "string"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "purpose": {
          "enum": [
            "explain",
            "demonstrate",
            "compare",
            "orient",
            "summarize",
            "emote"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "props": {
          "additionalProperties": true,
          "title": "Props",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "duration_s",
        "purpose",
        "props"
      ],
      "title": "ShortScene",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "theme": {
      "default": "editorial_science",
      "enum": [
        "editorial_science",
        "deep_space",
        "engineering_studio"
      ],
      "title": "Theme",
      "type": "string"
    },
    "aspect": {
      "default": "16:9",
      "enum": [
        "16:9",
        "9:16",
        "1:1"
      ],
      "title": "Aspect",
      "type": "string"
    },
    "fps": {
      "default": 30,
      "maximum": 120,
      "minimum": 1,
      "title": "Fps",
      "type": "integer"
    },
    "audio": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/ShortScene"
      },
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "captions": {
      "items": {
        "$ref": "#/$defs/ShortCaption"
      },
      "title": "Captions",
      "type": "array"
    }
  },
  "required": [
    "id",
    "title",
    "scenes"
  ],
  "title": "ShortStoryboard",
  "type": "object"
}
