{
  "$defs": {
    "Acceptance": {
      "additionalProperties": false,
      "properties": {
        "notes_total_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes Total Seconds"
        },
        "duration_tolerance_seconds": {
          "default": 2.0,
          "title": "Duration Tolerance Seconds",
          "type": "number"
        }
      },
      "title": "Acceptance",
      "type": "object"
    },
    "Authoring": {
      "additionalProperties": false,
      "description": "Optional paths to AI-drafted, human-approved authoring artifacts.",
      "properties": {
        "sources": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sources"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "brief": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brief"
        },
        "outline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outline"
        },
        "script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script"
        },
        "approval": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval"
        }
      },
      "title": "Authoring",
      "type": "object"
    },
    "BuildOptions": {
      "additionalProperties": false,
      "properties": {
        "allow_manual_animation_export": {
          "default": true,
          "title": "Allow Manual Animation Export",
          "type": "boolean"
        }
      },
      "title": "BuildOptions",
      "type": "object"
    },
    "Compose": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "deck",
            "scene",
            "recording"
          ],
          "title": "Mode",
          "type": "string"
        },
        "base_video": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Video"
        },
        "renderer": {
          "default": "timeline",
          "enum": [
            "timeline",
            "legacy"
          ],
          "title": "Renderer",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Compose",
      "type": "object"
    },
    "Content": {
      "additionalProperties": false,
      "properties": {
        "slides": {
          "title": "Slides",
          "type": "string"
        },
        "notes": {
          "title": "Notes",
          "type": "string"
        },
        "outline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outline"
        },
        "storyboard": {
          "title": "Storyboard",
          "type": "string"
        },
        "assets": {
          "title": "Assets",
          "type": "string"
        },
        "subtitles": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitles"
        }
      },
      "required": [
        "slides",
        "notes",
        "storyboard",
        "assets"
      ],
      "title": "Content",
      "type": "object"
    },
    "DurationPolicy": {
      "additionalProperties": false,
      "description": "Course-level duration contract (R1-5B).",
      "properties": {
        "profile": {
          "default": "standard",
          "enum": [
            "standard",
            "short",
            "news"
          ],
          "title": "Profile",
          "type": "string"
        },
        "target_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Seconds"
        },
        "min_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Seconds"
        },
        "max_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Seconds"
        },
        "page_tolerance_seconds": {
          "default": 1.5,
          "minimum": 0,
          "title": "Page Tolerance Seconds",
          "type": "number"
        }
      },
      "title": "DurationPolicy",
      "type": "object"
    },
    "Narration": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "timing": {
          "default": "planned",
          "enum": [
            "planned",
            "measured"
          ],
          "title": "Timing",
          "type": "string"
        },
        "mode": {
          "default": "reference_only",
          "enum": [
            "reference_only",
            "prompt_reference"
          ],
          "title": "Mode",
          "type": "string"
        },
        "style_enabled": {
          "default": true,
          "title": "Style Enabled",
          "type": "boolean"
        },
        "text_frontend": {
          "default": true,
          "title": "Text Frontend",
          "type": "boolean"
        },
        "speed": {
          "default": 1.0,
          "exclusiveMinimum": 0.5,
          "maximum": 2.0,
          "title": "Speed",
          "type": "number"
        }
      },
      "title": "Narration",
      "type": "object"
    },
    "Outputs": {
      "additionalProperties": false,
      "properties": {
        "fps": {
          "default": 30,
          "title": "Fps",
          "type": "integer"
        },
        "resolution": {
          "default": [
            1920,
            1080
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Resolution",
          "type": "array"
        },
        "slides_canvas": {
          "default": [
            1280,
            720
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Slides Canvas",
          "type": "array"
        },
        "animation_canvas": {
          "default": [
            1920,
            1080
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Animation Canvas",
          "type": "array"
        }
      },
      "title": "Outputs",
      "type": "object"
    },
    "Subtitles": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "render": {
          "default": "remotion",
          "enum": [
            "remotion",
            "burn_in"
          ],
          "title": "Render",
          "type": "string"
        },
        "top_language": {
          "default": "en",
          "title": "Top Language",
          "type": "string"
        },
        "bottom_language": {
          "default": "zh-Hans",
          "title": "Bottom Language",
          "type": "string"
        }
      },
      "title": "Subtitles",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "lesson_id": {
      "title": "Lesson Id",
      "type": "string"
    },
    "title_en": {
      "title": "Title En",
      "type": "string"
    },
    "title_zh": {
      "title": "Title Zh",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "final"
      ],
      "title": "Status",
      "type": "string"
    },
    "content": {
      "$ref": "#/$defs/Content"
    },
    "outputs": {
      "$ref": "#/$defs/Outputs"
    },
    "engines": {
      "items": {
        "enum": [
          "motion_canvas",
          "manim",
          "blender",
          "code_video"
        ],
        "type": "string"
      },
      "title": "Engines",
      "type": "array"
    },
    "compose": {
      "$ref": "#/$defs/Compose"
    },
    "narration": {
      "$ref": "#/$defs/Narration",
      "default": {
        "enabled": false,
        "source": null,
        "timing": "planned",
        "mode": "reference_only",
        "style_enabled": true,
        "text_frontend": true,
        "speed": 1.0
      }
    },
    "subtitles": {
      "$ref": "#/$defs/Subtitles",
      "default": {
        "enabled": false,
        "render": "remotion",
        "top_language": "en",
        "bottom_language": "zh-Hans"
      }
    },
    "acceptance": {
      "$ref": "#/$defs/Acceptance",
      "default": {
        "notes_total_seconds": null,
        "duration_tolerance_seconds": 2.0
      }
    },
    "build": {
      "$ref": "#/$defs/BuildOptions",
      "default": {
        "allow_manual_animation_export": true
      }
    },
    "duration": {
      "anyOf": [
        {
          "$ref": "#/$defs/DurationPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "authoring": {
      "anyOf": [
        {
          "$ref": "#/$defs/Authoring"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "lesson_id",
    "title_en",
    "title_zh",
    "status",
    "content",
    "outputs",
    "engines",
    "compose"
  ],
  "title": "LessonConfig",
  "type": "object"
}
