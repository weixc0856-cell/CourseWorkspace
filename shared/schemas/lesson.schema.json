{
  "$defs": {
    "Acceptance": {
      "additionalProperties": false,
      "properties": {
        "notes_total_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes Total Seconds"
        },
        "duration_tolerance_seconds": {
          "default": 2.0,
          "title": "Duration Tolerance Seconds",
          "type": "number"
        }
      },
      "title": "Acceptance",
      "type": "object"
    },
    "AudioPolicy": {
      "additionalProperties": false,
      "description": "Content-kind policy; formal courses and news never carry BGM.",
      "properties": {
        "content_kind": {
          "default": "formal_course",
          "enum": [
            "popular_science",
            "formal_course",
            "news"
          ],
          "title": "Content Kind",
          "type": "string"
        },
        "bgm": {
          "items": {
            "$ref": "#/$defs/BgmCue"
          },
          "title": "Bgm",
          "type": "array"
        }
      },
      "title": "AudioPolicy",
      "type": "object"
    },
    "Authoring": {
      "additionalProperties": false,
      "description": "Optional paths to AI-drafted, human-approved authoring artifacts.",
      "properties": {
        "sources": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sources"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "brief": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brief"
        },
        "outline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outline"
        },
        "script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script"
        },
        "approval": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval"
        },
        "narrative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narrative"
        }
      },
      "title": "Authoring",
      "type": "object"
    },
    "BgmCue": {
      "additionalProperties": false,
      "description": "One music bed interval; licence and level are part of the contract.",
      "properties": {
        "track_id": {
          "minLength": 1,
          "title": "Track Id",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "gain_db": {
          "default": -25.0,
          "maximum": 0.0,
          "minimum": -60.0,
          "title": "Gain Db",
          "type": "number"
        },
        "duck_db": {
          "default": 6.0,
          "maximum": 24.0,
          "minimum": 0.0,
          "title": "Duck Db",
          "type": "number"
        },
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution"
        },
        "license_status": {
          "default": "unknown",
          "enum": [
            "public_domain",
            "cc_by",
            "owner_authorized_unverified",
            "unknown"
          ],
          "title": "License Status",
          "type": "string"
        },
        "commercial_allowed": {
          "default": false,
          "title": "Commercial Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "track_id",
        "start_s",
        "end_s"
      ],
      "title": "BgmCue",
      "type": "object"
    },
    "BrandSegment": {
      "additionalProperties": false,
      "description": "One brand segment (intro or outro) around the lesson body.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "preset": {
          "default": "auto",
          "title": "Preset",
          "type": "string"
        },
        "duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.3,
              "maximum": 30.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration S"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "title": "BrandSegment",
      "type": "object"
    },
    "Branding": {
      "additionalProperties": false,
      "description": "Brand assets around the body. Disabled unless a lesson opts in.\n\nThe brand layer never touches narration, subtitles or shot timing: it is\nstitched after the viewing master is final, so the body timeline stays the\nsingle timing fact.",
      "properties": {
        "theme": {
          "const": "wayne-light",
          "default": "wayne-light",
          "title": "Theme",
          "type": "string"
        },
        "intro": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrandSegment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outro": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrandSegment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "preview_safe_area": {
          "default": false,
          "title": "Preview Safe Area",
          "type": "boolean"
        }
      },
      "title": "Branding",
      "type": "object"
    },
    "BuildOptions": {
      "additionalProperties": false,
      "properties": {
        "allow_manual_animation_export": {
          "default": true,
          "title": "Allow Manual Animation Export",
          "type": "boolean"
        },
        "strict_layout": {
          "default": false,
          "title": "Strict Layout",
          "type": "boolean"
        },
        "storyboard_source": {
          "default": "storyboard",
          "enum": [
            "storyboard",
            "director"
          ],
          "title": "Storyboard Source",
          "type": "string"
        }
      },
      "title": "BuildOptions",
      "type": "object"
    },
    "Compose": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "deck",
            "scene",
            "recording",
            "shots"
          ],
          "title": "Mode",
          "type": "string"
        },
        "base_video": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Video"
        },
        "renderer": {
          "default": "timeline",
          "enum": [
            "timeline",
            "legacy"
          ],
          "title": "Renderer",
          "type": "string"
        },
        "overlay": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overlay"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Compose",
      "type": "object"
    },
    "Content": {
      "additionalProperties": false,
      "properties": {
        "slides": {
          "title": "Slides",
          "type": "string"
        },
        "notes": {
          "title": "Notes",
          "type": "string"
        },
        "outline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outline"
        },
        "storyboard": {
          "title": "Storyboard",
          "type": "string"
        },
        "assets": {
          "title": "Assets",
          "type": "string"
        },
        "subtitles": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitles"
        }
      },
      "required": [
        "slides",
        "notes",
        "storyboard",
        "assets"
      ],
      "title": "Content",
      "type": "object"
    },
    "DurationPolicy": {
      "additionalProperties": false,
      "description": "Course-level duration contract (R1-5B).",
      "properties": {
        "profile": {
          "default": "standard",
          "enum": [
            "standard",
            "short",
            "news"
          ],
          "title": "Profile",
          "type": "string"
        },
        "target_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Seconds"
        },
        "min_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Seconds"
        },
        "max_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Seconds"
        },
        "page_tolerance_seconds": {
          "default": 1.5,
          "minimum": 0,
          "title": "Page Tolerance Seconds",
          "type": "number"
        }
      },
      "title": "DurationPolicy",
      "type": "object"
    },
    "MotionPolicy": {
      "additionalProperties": false,
      "description": "Slow still-image camera move for captured slides.",
      "properties": {
        "slides": {
          "default": "ken_burns",
          "enum": [
            "static",
            "ken_burns"
          ],
          "title": "Slides",
          "type": "string"
        },
        "scale": {
          "default": 1.05,
          "exclusiveMinimum": 1.0,
          "maximum": 1.15,
          "title": "Scale",
          "type": "number"
        },
        "pan_percent": {
          "default": 1.2,
          "maximum": 4.0,
          "minimum": 0.0,
          "title": "Pan Percent",
          "type": "number"
        }
      },
      "title": "MotionPolicy",
      "type": "object"
    },
    "Narration": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "timing": {
          "default": "planned",
          "enum": [
            "planned",
            "measured"
          ],
          "title": "Timing",
          "type": "string"
        },
        "mode": {
          "default": "reference_only",
          "enum": [
            "reference_only",
            "prompt_reference"
          ],
          "title": "Mode",
          "type": "string"
        },
        "style_enabled": {
          "default": true,
          "title": "Style Enabled",
          "type": "boolean"
        },
        "text_frontend": {
          "default": true,
          "title": "Text Frontend",
          "type": "boolean"
        },
        "speed": {
          "default": 1.0,
          "exclusiveMinimum": 0.5,
          "maximum": 2.0,
          "title": "Speed",
          "type": "number"
        }
      },
      "title": "Narration",
      "type": "object"
    },
    "Outputs": {
      "additionalProperties": false,
      "properties": {
        "fps": {
          "default": 30,
          "title": "Fps",
          "type": "integer"
        },
        "resolution": {
          "default": [
            1920,
            1080
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Resolution",
          "type": "array"
        },
        "slides_canvas": {
          "default": [
            1280,
            720
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Slides Canvas",
          "type": "array"
        },
        "animation_canvas": {
          "default": [
            1920,
            1080
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Animation Canvas",
          "type": "array"
        }
      },
      "title": "Outputs",
      "type": "object"
    },
    "Subtitles": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "render": {
          "default": "remotion",
          "enum": [
            "remotion",
            "burn_in"
          ],
          "title": "Render",
          "type": "string"
        },
        "mode": {
          "default": "cue",
          "enum": [
            "cue",
            "word"
          ],
          "title": "Mode",
          "type": "string"
        },
        "position": {
          "default": "bottom",
          "enum": [
            "bottom",
            "low_center"
          ],
          "title": "Position",
          "type": "string"
        },
        "word_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Word Source"
        },
        "bilingual": {
          "default": true,
          "title": "Bilingual",
          "type": "boolean"
        },
        "top_language": {
          "default": "en",
          "title": "Top Language",
          "type": "string"
        },
        "bottom_language": {
          "default": "zh-Hans",
          "title": "Bottom Language",
          "type": "string"
        },
        "bottom_margin": {
          "default": 190,
          "maximum": 400,
          "minimum": 0,
          "title": "Bottom Margin",
          "type": "integer"
        },
        "text_color": {
          "default": "#111111",
          "title": "Text Color",
          "type": "string"
        },
        "outline_color": {
          "default": "#FBFAF7",
          "title": "Outline Color",
          "type": "string"
        },
        "outline_width": {
          "default": 0,
          "maximum": 6,
          "minimum": 0,
          "title": "Outline Width",
          "type": "integer"
        }
      },
      "title": "Subtitles",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "lesson_id": {
      "title": "Lesson Id",
      "type": "string"
    },
    "title_en": {
      "title": "Title En",
      "type": "string"
    },
    "title_zh": {
      "title": "Title Zh",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "final"
      ],
      "title": "Status",
      "type": "string"
    },
    "content": {
      "$ref": "#/$defs/Content"
    },
    "outputs": {
      "$ref": "#/$defs/Outputs"
    },
    "engines": {
      "items": {
        "enum": [
          "motion_canvas",
          "manim",
          "blender",
          "code_video"
        ],
        "type": "string"
      },
      "title": "Engines",
      "type": "array"
    },
    "compose": {
      "$ref": "#/$defs/Compose"
    },
    "narration": {
      "$ref": "#/$defs/Narration",
      "default": {
        "enabled": false,
        "source": null,
        "timing": "planned",
        "mode": "reference_only",
        "style_enabled": true,
        "text_frontend": true,
        "speed": 1.0
      }
    },
    "subtitles": {
      "$ref": "#/$defs/Subtitles",
      "default": {
        "enabled": false,
        "render": "remotion",
        "mode": "cue",
        "position": "bottom",
        "word_source": null,
        "bilingual": true,
        "top_language": "en",
        "bottom_language": "zh-Hans",
        "bottom_margin": 190,
        "text_color": "#111111",
        "outline_color": "#FBFAF7",
        "outline_width": 0
      }
    },
    "acceptance": {
      "$ref": "#/$defs/Acceptance",
      "default": {
        "notes_total_seconds": null,
        "duration_tolerance_seconds": 2.0
      }
    },
    "build": {
      "$ref": "#/$defs/BuildOptions",
      "default": {
        "allow_manual_animation_export": true,
        "strict_layout": false,
        "storyboard_source": "storyboard"
      }
    },
    "motion": {
      "$ref": "#/$defs/MotionPolicy",
      "default": {
        "slides": "ken_burns",
        "scale": 1.05,
        "pan_percent": 1.2
      }
    },
    "audio": {
      "$ref": "#/$defs/AudioPolicy",
      "default": {
        "content_kind": "formal_course",
        "bgm": []
      }
    },
    "branding": {
      "$ref": "#/$defs/Branding",
      "default": {
        "theme": "wayne-light",
        "intro": null,
        "outro": null,
        "date": null,
        "preview_safe_area": false
      }
    },
    "video_form": {
      "default": "long",
      "enum": [
        "long",
        "short"
      ],
      "title": "Video Form",
      "type": "string"
    },
    "duration": {
      "anyOf": [
        {
          "$ref": "#/$defs/DurationPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "authoring": {
      "anyOf": [
        {
          "$ref": "#/$defs/Authoring"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "production": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Production"
    }
  },
  "required": [
    "schema_version",
    "lesson_id",
    "title_en",
    "title_zh",
    "status",
    "content",
    "outputs",
    "engines",
    "compose"
  ],
  "title": "LessonConfig",
  "type": "object"
}
