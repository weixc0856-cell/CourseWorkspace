{
  "$defs": {
    "Acceptance": {
      "additionalProperties": false,
      "properties": {
        "rubric": {
          "minLength": 1,
          "title": "Rubric",
          "type": "string"
        },
        "spec": {
          "default": null,
          "title": "Spec",
          "type": "string"
        },
        "gates": {
          "items": {
            "type": "string"
          },
          "title": "Gates",
          "type": "array"
        }
      },
      "required": [
        "rubric"
      ],
      "title": "Acceptance",
      "type": "object"
    },
    "Duration": {
      "additionalProperties": false,
      "properties": {
        "target_s": {
          "exclusiveMinimum": 0,
          "title": "Target S",
          "type": "number"
        },
        "min_s": {
          "default": null,
          "minimum": 0,
          "title": "Min S",
          "type": "number"
        },
        "max_s": {
          "default": null,
          "exclusiveMinimum": 0,
          "title": "Max S",
          "type": "number"
        }
      },
      "required": [
        "target_s"
      ],
      "title": "Duration",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirements",
          "type": "array"
        },
        "data_authority": {
          "default": null,
          "title": "Data Authority",
          "type": "string"
        },
        "render_only": {
          "items": {
            "type": "string"
          },
          "title": "Render Only",
          "type": "array"
        }
      },
      "required": [
        "requirements"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "product": {
      "minLength": 1,
      "title": "Product",
      "type": "string"
    },
    "title": {
      "default": null,
      "title": "Title",
      "type": "string"
    },
    "format": {
      "enum": [
        "course",
        "news",
        "explainer"
      ],
      "title": "Format",
      "type": "string"
    },
    "time_authority": {
      "enum": [
        "spec",
        "timeline",
        "audio"
      ],
      "title": "Time Authority",
      "type": "string"
    },
    "duration": {
      "$ref": "#/$defs/Duration"
    },
    "visual_sources": {
      "items": {
        "type": "string"
      },
      "title": "Visual Sources",
      "type": "array"
    },
    "narration": {
      "additionalProperties": true,
      "default": null,
      "title": "Narration",
      "type": "object"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "acceptance": {
      "$ref": "#/$defs/Acceptance"
    }
  },
  "required": [
    "schema_version",
    "product",
    "format",
    "time_authority",
    "duration",
    "evidence",
    "acceptance"
  ],
  "title": "Product profile",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courseworkspace.local/schemas/product.schema.json"
}
