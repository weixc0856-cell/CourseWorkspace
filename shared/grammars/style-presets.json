{
  "schema_version": 1,
  "presets": {
    "cinematic_realism": {
      "label": "Cinematic Realism",
      "use_for": [
        "landscape",
        "hero_shot",
        "documentary_reconstruction"
      ],
      "composition": {
        "subject": "right_third",
        "negative_space": "left",
        "horizon": "upper_third",
        "depth_layers": [
          "foreground",
          "midground",
          "background",
          "sky"
        ]
      },
      "camera": {
        "lenses": [
          35,
          40,
          45,
          50
        ],
        "move": "hold-dolly-hold",
        "height": "eye_or_slightly_low",
        "motion_blur_shutter": 0.5
      },
      "lighting": {
        "key": "warm_sun",
        "fill": "cool_area",
        "rim": "cool_area",
        "hdri": "pure_sky_or_mountain",
        "exposure": "AgX",
        "look": "AgX - Medium High Contrast"
      },
      "color": {
        "palette": [
          "sun_warm",
          "slate_blue",
          "moss_green",
          "rock_grey"
        ],
        "saturation": "restrained"
      },
      "sound": {
        "music": "sparse_or_none",
        "ambience": "wind_or_water"
      },
      "version": "1.0",
      "builder": {
        "color_management": "agx",
        "look": "AgX - Medium High Contrast",
        "exposure": 0.0,
        "world_strength": 0.35,
        "atmosphere_density": 6e-05,
        "lens_default": 45,
        "motion_blur_shutter": 0.5,
        "grain": "subtle",
        "typography": "editorial"
      }
    },
