{
  "schema_version": 1,
  "lesson": "lesson-smoke",
  "shot_id": "python_network_001",
  "session_id": "session-python-network-001",
  "environment": {
    "kind": "docker",
    "image": "course-tools:e1",
    "user": "course",
    "network": "bridge",
    "workdir": "/work",
    "cpus": 1.0,
    "memory": "768m",
    "pids": 128,
    "timeout_s": 180
  },
  "files": [
    { "source": "assets/code/python-001/venv-ok.txt", "path": "venv-ok.txt" },
    { "source": "assets/code/python-001/online-ok.txt", "path": "online-ok.txt" },
    { "source": "assets/code/python-001/offline-ok.txt", "path": "offline-ok.txt" }
  ],
  "commands": [
    { "id": "c1", "run": ["uv", "venv", ".venv"], "expect": { "exit_code": 0 } },
    { "id": "c1b", "run": ["bash", "-lc", "test -x .venv/bin/python && echo venv-ok"], "expect": { "exit_code": 0, "stdout": "venv-ok.txt" } },
    { "id": "c2", "run": ["uv", "pip", "install", "--python", ".venv/bin/python", "--no-index", "--find-links", "http://host.docker.internal:8899/", "course-demo-pkg"], "expect": { "exit_code": 0 } },
    { "id": "c3", "run": [".venv/bin/python", "-c", "import course_demo_pkg; print(course_demo_pkg.greet())"], "expect": { "exit_code": 0, "stdout": "online-ok.txt" } }
  ],
  "offline_commands": [
    { "id": "o1", "run": [".venv/bin/python", "-c", "import course_demo_pkg; print(course_demo_pkg.greet())"], "expect": { "exit_code": 0, "stdout": "offline-ok.txt" } }
  ],
  "record": {
    "target": "terminal",
    "capture": "window",
    "window_title": "CourseDemo",
    "resolution": [1280, 720],
    "fps": 30
  }
}
