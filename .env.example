# Reference for any OpenAI-compatible remote model provider.
# Copy to .env (git-ignored) and fill local values there.
# NEVER put an API key in this file or any other file; the key is read
# from the OS environment variable named by REMOTE_API_KEY_ENV.
REMOTE_ENABLED=true
REMOTE_PROVIDER=<deepseek|openai-compatible|other>
REMOTE_BASE_URL=<OPENAI_COMPATIBLE_BASE_URL>
REMOTE_MODEL=<MODEL_ID>
REMOTE_VISION_MODEL=<VISION_MODEL_ID_OR_EMPTY>
REMOTE_API_KEY_ENV=<API_KEY_ENV_VAR_NAME>

# DeepSeek example (current local setup):
# REMOTE_PROVIDER=deepseek
# REMOTE_BASE_URL=https://api.deepseek.com/v1
# REMOTE_MODEL=deepseek-flash
# REMOTE_VISION_MODEL=deepseek-flash
# REMOTE_API_KEY_ENV=DeepSeek-API

# OpenAI-compatible example:
# REMOTE_PROVIDER=openai-compatible
# REMOTE_BASE_URL=https://api.openai.com/v1
# REMOTE_MODEL=gpt-4o-mini
# REMOTE_VISION_MODEL=gpt-4o-mini
# REMOTE_API_KEY_ENV=OPENAI_API_KEY
