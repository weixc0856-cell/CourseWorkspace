# Optional non-secret environment reference. Do NOT put an API key here.
# The real key is read from the existing OS environment variable DeepSeek-API.
# DeepSeek is pinned to deepseek-flash; deepseek-v4-pro is disabled.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
