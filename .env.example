# Remote model fallback for local-model workflows.
# Copy to .env (ignored) or set these in the shell.
# DEEPSEEK_API_KEY is the portable name; "DeepSeek-API" is accepted as an alias.
# DeepSeek is pinned to deepseek-flash; deepseek-v4-pro is disabled.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
